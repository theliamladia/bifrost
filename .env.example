# ---- Server ----
PORT=8787
NODE_ENV=development

# Signing key for verification session tokens. REQUIRED in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Shared secret for the admin-approval gate (the ONLY path to a non-self lookup).
# Leave empty to disable third-party lookups entirely (recommended default).
ADMIN_API_KEY=

# OTP delivery. "console" prints codes to the server log (dev only).
OTP_EMAIL_PROVIDER=console   # console | postmark | ses
OTP_SMS_PROVIDER=console     # console | twilio

# Postmark (email OTP)
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM=no-reply@example.com

# AWS SES (email OTP) — uses the default AWS credential chain via the SES v2 HTTPS API
AWS_REGION=us-east-1
SES_FROM=no-reply@example.com

# Twilio (SMS OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+15550001111

# ---- Data sources ----
# SerpAPI is the only Google path. No direct scraping.
SERPAPI_KEY=

# ---- Client ----
# Dev server proxies /api to the backend; override only if hosting separately.
VITE_API_BASE=

# ---- Rate limits (optional overrides) ----
LIMIT_START_PER_IP=10
LIMIT_START_PER_CONTACT=5
LIMIT_CONFIRM_PER_IP=30
LIMIT_SCANS_PER_IP=20
