# ---- Server ----
PORT=8787
NODE_ENV=development

# Signing key for redeemed-approval session tokens. REQUIRED in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Shared secret for the approval gate. An administrator uses it to approve each
# scan; every scan requires one, including a person checking their own name.
# Unset means nothing can be approved, so nothing runs. REQUIRED in production.
ADMIN_API_KEY=

# ---- Data sources ----
# SerpAPI is the only Google path. No direct scraping.
SERPAPI_KEY=

# ---- Client ----
# Dev server proxies /api to the backend; override only if hosting separately.
VITE_API_BASE=

# ---- Rate limits (optional overrides) ----
LIMIT_REDEEM_PER_IP=30
LIMIT_SCANS_PER_IP=20
